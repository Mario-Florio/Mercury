{
	"name": "mercury-monorepo",
	"lockfileVersion": 3,
	"requires": true,
	"packages": {
		"": {
			"name": "mercury-monorepo",
			"workspaces": [
				"packages/*"
			],
			"engines": {
				"node": ">=22.18.0"
			}
		},
		"node_modules/@mercurypress/astro": {
			"resolved": "packages/astro",
			"link": true
		},
		"node_modules/@mercurypress/core": {
			"resolved": "packages/core",
			"link": true
		},
		"node_modules/@mercurypress/create": {
			"resolved": "packages/create",
			"link": true
		},
		"packages/astro": {
			"name": "@mercurypress/astro",
			"version": "0.0.0"
		},
		"packages/core": {
			"name": "@mercurypress/core",
			"version": "0.0.0"
		},
		"packages/create": {
			"name": "@mercurypress/create",
			"version": "0.0.0"
		}
	}
}
